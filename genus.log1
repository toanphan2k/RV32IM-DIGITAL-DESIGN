@file(synth.tcl) 26: set rtl_handle [open $RTL_LIST r]
@file(synth.tcl) 27: set RTL_FILES [list]
@file(synth.tcl) 28: while {[gets $rtl_handle line] >= 0} {
    set line [string trim $line]
    if {$line eq "" || [string match "#*" $line]} {
        continue
    }
    # Genus ignores $readmemh, so replace the simulation ROM implementation.
    if {[file tail $line] eq "imem_rom.sv"} {
        continue
    }
    set source_file [file join $RTL_DIR [file tail $line]]
    if {![file isfile $source_file]} {
        close $rtl_handle
        error "RTL source not found: $source_file"
    }
    lappend RTL_FILES $source_file
}
@file(synth.tcl) 44: close $rtl_handle
@file(synth.tcl) 46: file mkdir $OUTPUT_DIR
@file(synth.tcl) 47: if {![file isfile $IMEM_IMAGE]} {
    error "Instruction memory image not found: $IMEM_IMAGE"
}
@file(synth.tcl) 51: set package_handle [open [file join $RTL_DIR def_pkg.sv] r]
@file(synth.tcl) 52: set package_source [read $package_handle]
@file(synth.tcl) 53: close $package_handle
@file(synth.tcl) 54: if {![regexp {localparam\s+int\s+NUM_WORDS\s*=\s*([0-9]+)\s*;} $package_source -> imem_depth]} {
    error "Could not read NUM_WORDS from rtl/def_pkg.sv"
}
@file(synth.tcl) 58: set imem_words [dict create]
@file(synth.tcl) 59: set imem_address 0
@file(synth.tcl) 60: set imem_handle [open $IMEM_IMAGE r]
@file(synth.tcl) 61: while {[gets $imem_handle line] >= 0} {
    set line [string trim [regsub {//.*$} $line ""]]
    foreach token [regexp -all -inline {\S+} $line] {
        if {[regexp {^@([0-9a-fA-F]+)$} $token -> hex_address]} {
            if {[scan $hex_address %x imem_address] != 1} {
                close $imem_handle
                error "Invalid address in instruction memory image: $token"
            }
            continue
        }

        set word [string map {_ ""} $token]
        if {![regexp {^[0-9a-fA-F]+$} $word] || [string length $word] > 8} {
            close $imem_handle
            error "Invalid 32-bit hex word in instruction memory image: $token"
        }
        if {$imem_address >= $imem_depth} {
            close $imem_handle
            error "Instruction memory image exceeds NUM_WORDS ($imem_depth)"
        }
        dict set imem_words $imem_address $word
        incr imem_address
    }
}
@file(synth.tcl) 85: close $imem_handle
@file(synth.tcl) 86: if {[dict size $imem_words] == 0} {
    error "Instruction memory image is empty: $IMEM_IMAGE"
}
@file(synth.tcl) 90: set rom_handle [open $IMEM_ROM w]
@file(synth.tcl) 91: puts $rom_handle "import RV32_PKG::*;"
@file(synth.tcl) 92: puts $rom_handle "module imem_rom ("
@file(synth.tcl) 93: puts $rom_handle "    input logic \[\$clog2(NUM_WORDS) - 1:0\] addr,"
@file(synth.tcl) 94: puts $rom_handle "    output logic \[INST_SIZE - 1:0\] data"
@file(synth.tcl) 95: puts $rom_handle ");"
@file(synth.tcl) 96: puts $rom_handle "    always_comb begin"
@file(synth.tcl) 97: puts $rom_handle "        case (addr)"
@file(synth.tcl) 98: foreach address [lsort -integer [dict keys $imem_words]] {
    puts $rom_handle "            $address: data = 32'h[dict get $imem_words $address];"
}
@file(synth.tcl) 101: puts $rom_handle "            default: data = '0;"
@file(synth.tcl) 102: puts $rom_handle "        endcase"
@file(synth.tcl) 103: puts $rom_handle "    end"
@file(synth.tcl) 104: puts $rom_handle "endmodule"
@file(synth.tcl) 105: close $rom_handle
@file(synth.tcl) 106: lappend RTL_FILES $IMEM_ROM
@file(synth.tcl) 107: puts "Generated instruction ROM from $IMEM_IMAGE"
