@file(synth.tcl) 37: while {[gets $rtl_handle line] >= 0} {
    set line [string trim $line]
    if {$line eq "" || [string match "#*" $line]} {
        continue
    }
    if {[lsearch -exact $SYNTH_EXCLUDED_RTL [file tail $line]] >= 0} {
        continue
