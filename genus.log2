@file(synth.tcl) 25: set rtl_handle [open $RTL_LIST r]
@file(synth.tcl) 26: set RTL_FILES [list]
@file(synth.tcl) 27: while {[gets $rtl_handle line] >= 0} {
    set line [string trim $line]
    if {$line eq "" || [string match "#*" $line]} {
        continue
    }
    if {[lsearch -exact $SYNTH_EXCLUDED_RTL [file tail $line]] >= 0} {
        continue
    }
    set source_file [file join $RTL_DIR [file tail $line]]
    if {![file isfile $source_file]} {
        close $rtl_handle
        error "RTL source not found: $source_file"
    }
    lappend RTL_FILES $source_file
}
@file(synth.tcl) 42: close $rtl_handle
